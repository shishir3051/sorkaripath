PORT=5050
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/bd_govt_job_portal?retryWrites=true&w=majority&appName=Cluster0
CORS_ORIGIN=http://localhost:3000
CORS_ALLOW_VERCEL_PREVIEWS=false
CORS_VERCEL_PROJECT_PREFIX=
ADMIN_API_KEY=replace-with-random-secret-at-least-16-chars
CRON_SECRET=replace-with-random-secret-at-least-16-chars
PUBLIC_SYNC_COOLDOWN_SEC=180
AUTO_SYNC_STALE_MINUTES=30
SYNC_CRON_SCHEDULE=0 */6 * * *
SCRAPER_TIMEOUT_MS=10000
GEMINI_API_KEY=replace-with-your-primary-gemini-api-key
# Optional backup keys (comma-separated, or GEMINI_API_KEY_2 / _3) for auto-failover on quota/rate limits
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-4-hydrogen

# Authentication & Admin Bootstrap
JWT_SECRET=replace-with-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=sp_auth_token
ADMIN_EMAILS=admin@example.com

# SMTP Email Delivery (Gmail App Password example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=SorkariPath <your-email@gmail.com>
